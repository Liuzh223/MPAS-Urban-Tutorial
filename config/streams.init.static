<streams>
  <immutable_stream name="input" type="input"
    filename_template="heatwave2022.grid.nc"
    input_interval="initial_only" />
  <immutable_stream name="output" type="output"
    filename_template="heatwave2022.static.nc"
    packages="initial_conds" output_interval="initial_only" />
  <immutable_stream name="surface" type="output"
    filename_template="heatwave2022.sfc_update.nc"
    filename_interval="none" packages="sfc_update"
    output_interval="3600" />
  <immutable_stream name="lbc" type="output"
    filename_template="lbc.$Y-$M-$D_$h.$m.$s.nc"
    filename_interval="output_interval" packages="lbcs"
    output_interval="3:00:00" />
</streams>
